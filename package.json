{
  "name": "guardbee-vscode",
  "displayName": "GuardBee",
  "icon": "media/icon.png",
  "description": "Review GuardBee findings in the editor and run dashboard scans from the sidebar.",
  "version": "0.1.4",
  "publisher": "guardbee-ai",
  "license": "MIT",
  "homepage": "https://github.com/GuardBee/guardbee-vscode#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/GuardBee/guardbee-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/GuardBee/guardbee-vscode/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "guardbee",
    "linter",
    "diagnostics"
  ],
  "galleryBanner": {
    "color": "#0B1C2C",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "guardbee.scanCurrentFile",
        "title": "GuardBee: Scan Current File"
      },
      {
        "command": "guardbee.scanWorkspace",
        "title": "GuardBee: Scan Workspace"
      },
      {
        "command": "guardbee.connect",
        "title": "GuardBee: Connect Account"
      },
      {
        "command": "guardbee.disconnect",
        "title": "GuardBee: Disconnect"
      },
      {
        "command": "guardbee.triggerRemoteScan",
        "title": "GuardBee: Trigger Remote Scan"
      },
      {
        "command": "guardbee.showRecentScans",
        "title": "GuardBee: Show Recent Scans"
      }
    ],
    "configuration": {
      "title": "GuardBee",
      "properties": {
        "guardbee.enabledScanners": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Local analyzers to run on save or on demand."
        },
        "guardbee.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run local analysis automatically when a file is saved."
        },
        "guardbee.severityThreshold": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "default": "low",
          "description": "Minimum severity to report as a diagnostic."
        },
        "guardbee.apiBaseUrl": {
          "type": "string",
          "default": "https://app.guardbee.ai/api/v1",
          "description": "GuardBee dashboard endpoint."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "guardbee",
          "title": "GuardBee",
          "icon": "media/guardbee.svg"
        }
      ]
    },
    "views": {
      "guardbee": [
        {
          "id": "guardbeeLocalFindings",
          "name": "Local Findings"
        },
        {
          "id": "guardbeeRemoteScans",
          "name": "Remote Scans"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "compile-tests": "tsc -p . --outDir out",
    "pretest": "npm run compile && npm run compile-tests",
    "test": "vscode-test",
    "package": "node scripts/package-vsix.js",
    "package:stub": "node scripts/package-vsix.js --stub",
    "publish:marketplace": "node scripts/package-vsix.js --publish",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@guardbee/mcp-ai-code-scanner": "^0.2.2",
    "@guardbee/mcp-prompt-injection-scanner": "^0.1.2",
    "@guardbee/mcp-secret-scanner": "^0.2.2",
    "@guardbee/mcp-server-auditor": "^0.1.2",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.23.0",
    "minimatch": "^9.0.5",
    "mocha": "^10.7.0",
    "typescript": "^5.5.4",
    "yaml": "^2.5.1"
  }
}
